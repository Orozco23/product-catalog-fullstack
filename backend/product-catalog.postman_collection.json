							"mode": "raw",
							"raw": "{\r\n    \"email\": {{email}},\r\n    \"password\": {{password}}\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}auth/login",
